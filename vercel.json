{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/about/?",
      "dest": "/about/index.html"
    },
    {
      "src": "/location/?",
      "dest": "/location/index.html"
    },
    {
      "src": "/services/home-care/?",
      "dest": "/services/home-care/index.html"
    },
    {
      "src": "/services/live-in-care/?",
      "dest": "/services/live-in-care/index.html"
    },
    {
      "src": "/services/equipment/?",
      "dest": "/services/equipment/index.html"
    },
    {
      "src": "/guide/insurance/?",
      "dest": "/guide/insurance/index.html"
    },
    {
      "src": "/guide/application/?",
      "dest": "/guide/application/index.html"
    },
    {
      "src": "/guide/process/?",
      "dest": "/guide/process/index.html"
    },
    {
      "src": "/guide/cost/?",
      "dest": "/guide/cost/index.html"
    },
    {
      "src": "/news/?",
      "dest": "/news/index.html"
    },
    {
      "src": "/care-info/?",
      "dest": "/care-info/index.html"
    },
    {
      "src": "/news/site-guide/?",
      "dest": "/news/site-guide/index.html"
    },
    {
      "src": "/care-info/consultation-checklist/?",
      "dest": "/care-info/consultation-checklist/index.html"
    },
    {
      "src": "/faq/?",
      "dest": "/faq/index.html"
    },
    {
      "src": "/contact/?",
      "dest": "/contact/index.html"
    },
    {
      "src": "/careers/?",
      "dest": "/careers/index.html"
    },
    {
      "src": "/privacy/?",
      "dest": "/privacy/index.html"
    },
    {
      "src": "/terms/?",
      "dest": "/terms/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
